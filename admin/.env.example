# Same Supabase project as the web app
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for you and your mom to log into the admin app.
# Pick something you wouldn't mind texting each other.
ADMIN_PASSWORD=

# Random long string, used to sign the login cookie. Generate once with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=
